.DS_Store
.vscode
.virtual_documents
.Rhistory
*.png
*.jpg
*.tif
# Figures are ignored by default; weighting_analysis/ is the one folder whose
# PNGs are committed (its rasters take over an hour to rebuild). A negation
# must name the CURRENT directory path -- an earlier one pointed at a folder
# that had since been renamed and silently stopped matching.
!weighting_analysis/*.png
.~*
*.swp
__pycache__/
*.mat
*.pkl
*.asv
*.npz
# The weighting_analysis/ caches specifically: that folder is historical and
# inactive, and its rasters are all regenerable from committed scripts
# (_cache_ears.npz is the expensive one -- well over an hour on 10 workers).
# Stated explicitly so the blanket *.npz above is not later negated for it the
# way *.png was for this folder.
weighting_analysis/_cache_*.npz
# OSX / *nix default autosave extension
*.m~
# Compiled MEX binaries (all platforms)
*.mex*
# Packaged app and toolbox files
*.mlappinstall
*.mltbx
# Matlab code generation folders
codegen/
# Jupyter
*.ipynb_checkpoints
# latex
*.aux
*.log
*.gz
*.pdf
# Claude
*.lock
# per-machine worker-count etc.; see machine_config.template.py
machine_config.py
